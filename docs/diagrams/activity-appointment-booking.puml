@startuml
skinparam shadowing false
skinparam activity {
  BackgroundColor white
  BorderColor #64748b
  DiamondBackgroundColor #eff6ff
  DiamondBorderColor #3b82f6
  StartColor #2563eb
  EndColor #2563eb
}

title Диаграмма деятельности\nСценарий: запись пациента на приём

start

:Пациент авторизуется в системе;
:Открывает страницу записи на приём;
:Выбирает специальность;
:Frontend запрашивает список врачей\nи услуг по выбранной специальности;
:Показывается список врачей,\nдоступных для записи;

:Пациент выбирает врача;
:Пациент выбирает услугу;
:Пациент выбирает дату;

:Frontend отправляет запрос\nна получение доступных слотов;
:Backend получает расписание врача\nи существующие записи;

if (Есть свободные слоты?) then (Да)
  :Показать доступные временные интервалы;
  :Пациент выбирает время;
  :Пациент вводит причину обращения;
  :Frontend отправляет запрос\nна создание записи;

  :Backend проверяет:
  - принадлежность услуги специальности врача
  - попадание слота в расписание
  - отсутствие пересечения у врача
  - отсутствие пересечения у пациента;

  if (Проверка успешна?) then (Да)
    :Создать Appointment;
    :Рассчитать endTime\nпо длительности услуги;
    :Сохранить запись в БД;
    :Вернуть успешный ответ;
    :Frontend показывает подтверждение;
    :Запись отображается\nв списке будущих посещений;
  else (Нет)
    :Вернуть сообщение об ошибке;
    :Frontend показывает уведомление\nо невозможности записи;
  endif

else (Нет)
  :Frontend показывает сообщение\n"Нет доступных слотов";
endif

stop
@enduml
